# Port the bridge listens on
PORT=3100

# Shared secret. The calling app (SIAL Apps) must send this as the "x-api-key"
# header on every /send, /send-media and /check-number call. Use a long random
# string and set the SAME value as WHATSAPP_API_KEY in the SIAL app's .env.
API_KEY=change-me-to-a-long-random-secret

# Throttle between messages (ms). A random delay in this range is used so a
# stream of notifications looks natural and reduces ban risk.
MIN_DELAY_MS=3000
MAX_DELAY_MS=8000

# How many times to retry a single message before giving up.
MAX_RETRIES=3

# Verify the number is registered on WhatsApp before sending (true/false).
# Keep this FALSE: the SIAL app pre-verifies every number once (via the
# /check-number endpoint) and caches the result, so the bridge does NOT need to
# re-run a lookup on every send. Set true only if a caller sends WITHOUT
# pre-verifying and you want the bridge to catch typos / non-WhatsApp numbers.
VERIFY_NUMBER=false

# Winston log level: error | warn | info | debug
LOG_LEVEL=info

# Where the WhatsApp session is stored so you don't re-scan the QR every restart.
# Defaults to ./.wwebjs_auth if left unset.
# SESSION_PATH=./.wwebjs_auth
